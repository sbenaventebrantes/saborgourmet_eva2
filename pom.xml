<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        spring-boot-starter-parent entrega la gestion centralizada de versiones:
        al declarar las dependencias mas abajo no indicamos su version, porque el
        parent ya define versiones compatibles entre si para todo el ecosistema Spring.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>cl.ipss</groupId>
    <artifactId>sabor-gourmet</artifactId>
    <version>1.0.0</version>
    <name>sabor-gourmet</name>
    <description>Sistema de reservas del Restaurante Sabor Gourmet - Evaluacion Unidad 2</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!--
            Spring MVC + servidor Tomcat embebido.
            Permite declarar controladores (@Controller) que atienden peticiones HTTP
            y devuelven el nombre de una vista para que Thymeleaf la renderice.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Thymeleaf: motor de plantillas que genera el HTML en el servidor.
            Spring Boot lo autoconfigura para buscar las vistas en
            src/main/resources/templates y resolverlas por su nombre.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!--
            Spring Data JPA + Hibernate: mapea las clases del paquete model a tablas
            y genera la implementacion de los repositorios en tiempo de ejecucion.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Bean Validation: habilita anotaciones como @NotBlank o @Min en los
            formularios y entidades, y su verificacion automatica con @Valid.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Base de datos H2 en memoria. Se usa en desarrollo y pruebas para que el
            proyecto se ejecute sin instalar ningun motor de base de datos aparte.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Dependencias usadas solo al ejecutar las pruebas automatizadas. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Permite ejecutar la aplicacion con: mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
